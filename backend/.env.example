# Optional: Comma-separated list of allowed CORS origins
# Development: Leave empty to use default localhost origins
# Production: Set to your deployed frontend URL
# Example: CORS_ORIGINS=https://your-app.vercel.app,https://your-app-staging.vercel.app
# CORS_ORIGINS=

# Optional: Custom database file path
# Development: Defaults to ./typeform.db in backend directory
# Production on Render: /opt/render/project/data/typeform.db
# Production on Railway: /app/data/typeform.db
# DATABASE_PATH=./typeform.db
